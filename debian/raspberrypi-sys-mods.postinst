#!/bin/sh -e

case "${1}" in
  configure)
    if dpkg --compare-versions "$2" lt-nl 1:20250627; then
        dpkg-divert --package raspberrypi-sys-mods --remove --rename \
            --divert /usr/lib/python3.11/EXTERNALLY-MANAGED.orig /usr/lib/python3.11/EXTERNALLY-MANAGED
    fi
    if dpkg --compare-versions "$2" lt 1:20251028+1; then
        if [ -d /var/lib/systemd/timesync/clock ]; then
            rm -rf /var/lib/systemd/timesync/clock
            touch /var/lib/systemd/timesync/clock
            chown systemd-timesync:systemd-timesync /var/lib/systemd/timesync/clock
        fi
    fi
    if dpkg --compare-versions "$2" le-nl 1:20251028+1; then
        for old_nopasswd in /etc/sudoers.d/010_pi-nopasswd.dpkg-remove /etc/sudoers.d/010_pi-nopasswd.dpkg-backup; do
          if [ -f "$old_nopasswd" ]; then
              echo "Relinquishing package ownership of 010_pi-nopasswd..."
              mv -v "$old_nopasswd" /etc/sudoers.d/010_pi-nopasswd
              break
          fi
        done
    fi
    ;;

  abort-upgrade|abort-remove|abort-deconfigure)
    ;;

  *)
    echo "postinst called with unknown argument \`${1}'" >&2
    exit 1
    ;;
esac

#DEBHELPER#
